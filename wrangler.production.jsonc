{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "VERSION",
  },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"],
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openboard-production",
      "database_id": "80183a98-27da-4759-a1b1-29c4180afe92",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openboard-production-files",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["auth@alexlazar.dev"],
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://openboard.alexlazar.dev",
    "EMAIL_TRANSPORT": "cloudflare",
    "EMAIL_FROM": "auth@alexlazar.dev",
  },
}
